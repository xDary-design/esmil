# ------------------------------------------------------------------
# Copia este archivo como ".env" y llena tus datos reales.
# Si en el futuro quieres vigilar OTRA pagina, solo cambia TARGET_URL
# (y si hace falta, las otras variables). El codigo no se toca.
# ------------------------------------------------------------------

# Pagina que se va a revisar cada hora
TARGET_URL=https://tinyurl.com/admisionejercitoecuatoriano

# Dato para entrar/consultar cuando la pagina ya funcione.
# Si esa pagina solo pide cedula (sin clave), deja PORTAL_PASSWORD vacio
# y pones tu cedula en PORTAL_USER. Si algun dia vigilas otra pagina que
# SI pide usuario y clave, llena las dos.
PORTAL_USER=
PORTAL_PASSWORD=

# Palabras que indican que la pagina SIGUE sin funcionar (separadas por coma).
# Deja vacio si no sabes cuales poner: el robot igual detecta solo si aparece
# el campo para escribir la cedula (o usuario).
UNAVAILABLE_KEYWORDS=no disponible,no está disponible,cerrado,en mantenimiento,próximamente,error

# Avanzado / opcional: solo llenar si el robot no encuentra los campos solo.
# Son selectores CSS que le dicen donde hacer clic o escribir.
USERNAME_SELECTOR=
PASSWORD_SELECTOR=
SUBMIT_SELECTOR=

# Cuenta de Gmail que ENVIA el correo de aviso.
# GMAIL_APP_PASSWORD no es tu clave normal: es una "clave de aplicacion"
# de 16 letras que generas en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Correo(s) que RECIBEN el aviso. Si se deja vacio, se usa GMAIL_USER.
NOTIFY_EMAIL=dllerena120@gmail.com

# Zona horaria para que la fecha del correo salga correcta (opcional)
TIMEZONE=America/Guayaquil
